# The functions' environment, deployed by `firebase deploy` (Firebase params). Not secret.
# Every key is declared once, with its meaning and default, on the typed section that reads it
# in core/config/settings.py (tests/test_config.py checks the two agree). Values are baked in
# at deploy time.
# functions/.env.local (git-ignored) overrides any of these for the emulator only.

# ── Model ─────────────────────────────────────────────────────────────────────
# Which model answers, as <provider>/<model>. Providers: vertex (Gemini on Vertex AI),
# ollama (a model on this machine; set it in .env.local, e.g. AI_MODEL=ollama/qwen2.5vl:7b).
AI_MODEL=vertex/gemini-3.8-flash
AI_MAX_OUTPUT_TOKENS=2048
# Empty = the model's own default (1.0 for Gemini 3, which Google recommends keeping).
AI_TEMPERATURE=

# Vertex AI — the runtime service account needs roles/aiplatform.user.
VERTEX_LOCATION=us-central1
VERTEX_THINKING_LEVEL=low
VERTEX_MEDIA_RESOLUTION=high

# Ollama — only used when AI_MODEL starts with ollama/.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_TOKENS=32768

# ── Request limits ────────────────────────────────────────────────────────────
MAX_IMAGES=10
MAX_IMAGE_BYTES=4000000
MAX_TOTAL_IMAGE_BYTES=16000000
MAX_MESSAGES=200
MAX_LINES=3

# ── Stored screenshots ────────────────────────────────────────────────────────
IMAGE_MAX_SIDE=1600
IMAGE_JPEG_QUALITY=85
# Empty = the project's default Firebase bucket.
STORAGE_BUCKET=

# ── Conversations (wizard-app/CONVERSATIONS.md) ───────────────────────────────
# Nothing expires: no TTL policy, no retention param. See CONVERSATIONS.md §7.
MAX_MESSAGES_PER_CONVERSATION=200
PREVIEW_CHARS=140
TITLE_CHARS=60

# ── Generation queue ──────────────────────────────────────────────────────────
# The rate limiter (Cloud Tasks RateLimits) and the retry policy. Project-wide, not per user:
# see wizard-app/CONVERSATIONS.md for what that does and does not cover.
QUEUE_MAX_DISPATCHES_PER_SECOND=100
QUEUE_MAX_CONCURRENT_DISPATCHES=1000
QUEUE_MAX_ATTEMPTS=3

# ── Lines that land ───────────────────────────────────────────────────────────
# How often `refresh_lines` regenerates the content (the schedule is fixed at deploy time); the
# same number drives Cache-Control and the app's cache TTL.
LINES_REFRESH_INTERVAL_HOURS=24
# The category ids (in the order the app renders them, and the enum of the response schema)
# and how many lines each gets.
LINES_CATEGORY_IDS=opening,followup,closing
LINES_PER_CATEGORY=5
# The languages every generated text must carry (required properties of each text).
LINES_LOCALES=en,es
# {categories} {count} {lines_per_category} {locales} are filled in from the values above, so
# the prompt cannot ask for something the response schema forbids.
LINES_SYSTEM_PROMPT="You write ready-to-paste lines for a BUYER negotiating on peer-to-peer marketplaces (Facebook Marketplace, eBay, Craigslist, OLX). Every line is one message the buyer sends the seller: short, natural, specific, never rude, never a template with placeholders."
LINES_TASK_PROMPT="Produce exactly {count} categories with these ids and nothing else: {categories} — the opening message, the follow-up when the seller hesitates or goes quiet, and the line that closes the deal. Name each category in two or three words. Give each category exactly {lines_per_category} lines, all different in tactic: they should cover price anchoring, bundling or pickup convenience, naming a flaw, walking away politely, and agreeing quickly. No line mentions a specific item, brand or price. Write every text in all of these languages: {locales}."

# ── Security ──────────────────────────────────────────────────────────────────
# Set to true once the app ships Firebase App Check (App Attest / Play Integrity).
REQUIRE_APP_CHECK=false

# ── Function resources ────────────────────────────────────────────────────────
INSTANCE_MEMORY_MB=512
REQUEST_TIMEOUT_SEC=60
MAX_INSTANCES=20
