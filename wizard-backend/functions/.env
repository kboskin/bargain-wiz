# Deployed as function environment by `firebase deploy` (Firebase params). Not secret.
# Every value here is a fallback override; see functions/config.py for the meaning of each.

# Vertex AI (the runtime service account needs roles/aiplatform.user)
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_THINKING_BUDGET=0
VERTEX_TEMPERATURE=0.7
VERTEX_MAX_OUTPUT_TOKENS=2048

# Request limits
MAX_IMAGES=6
MAX_IMAGE_BYTES=1500000
MAX_TOTAL_IMAGE_BYTES=6000000
MAX_TEXT_CHARS=8000
MAX_MESSAGE_CHARS=4000
MAX_MESSAGES=40
MAX_LINES=3
DEFAULT_VIBE=friendly
DEFAULT_PUSH=60

# Stored screenshots
IMAGE_MAX_SIDE=1600
IMAGE_JPEG_QUALITY=85

# Conversations (wizard-app/CONVERSATIONS.md). Empty bucket = the project's default one.
# Add a Firestore TTL policy on `expires_at` for the `conversations` collection group.
STORAGE_BUCKET=
CONVERSATION_RETENTION_DAYS=180
MAX_TURNS_PER_DAY=100
MAX_MESSAGES_PER_CONVERSATION=200
PREVIEW_CHARS=140
TITLE_CHARS=60

# Profile (wizard-app/PROFILE_SYNC.md)
# Everything about a person lives under this one collection (profile document plus its
# conversations / limits subcollections).
USERS_COLLECTION=users
PROFILE_MAX_STR=500
PROFILE_MAX_KEY=64
PROFILE_MAX_ANSWERS=64
PROFILE_MAX_LIST=32
PROFILE_MAX_HURDLES=16
PROFILE_MAX_FLOW_STEPS=40

# Lines that land: Cache-Control max-age and the app's on-device cache TTL / caption.
LINES_REFRESH_INTERVAL_HOURS=24

# Set to true once the app ships Firebase App Check (App Attest / Play Integrity).
REQUIRE_APP_CHECK=false

# Function resources
INSTANCE_MEMORY_MB=512
REQUEST_TIMEOUT_SEC=60
MAX_INSTANCES=20
