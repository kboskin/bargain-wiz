# Deployed as function environment (firebase deploy). Not secret.
# How often the "Lines that land" content is refreshed: server cache TTL, Cache-Control
# max-age, the app's on-device cache TTL and its "new lines every …" caption.
LINES_REFRESH_INTERVAL_HOURS=24

# Gemini on Vertex AI (express_dealmaker / pro_deal_closer). The function's service account
# needs roles/aiplatform.user in this project.
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# 0 = thinking off (fast, cheap). -1 = don't send the setting (models without thinking).
VERTEX_THINKING_BUDGET=0
